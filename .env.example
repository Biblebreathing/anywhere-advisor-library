# Copy to .env.local for local development. In Vercel, add these under Project → Settings → Environment Variables.

# The public address of the library, no trailing slash
NEXT_PUBLIC_SITE_URL=https://library.theanywhereadvisor.com

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GoHighLevel
GHL_LOCATION_ID=OU1HhJC2zJE9FO6uhfVV
# GHL → Settings → Private Integrations. Scopes: contacts.write, contacts.readonly
GHL_API_TOKEN=
# A long random string. GHL workflows call /api/ghl/purchase?secret=THIS_VALUE
GHL_WEBHOOK_SECRET=
# Optional: ID of a GHL contact custom field that receives the student's login link,
# so your GHL welcome email can include it. Leave empty to have Supabase email the link.
GHL_LOGIN_LINK_FIELD_ID=
